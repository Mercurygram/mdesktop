[Desktop Entry]
Name=Mercurygram
Comment=New era of messaging
TryExec=Mercurygram
Exec=Mercurygram -- %U
Icon=it.belloworld.mercurygram.desktop
Terminal=false
StartupWMClass=MercurygramDesktop
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;mercurygram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Mercurygram -quit
Name=Quit Mercurygram
Icon=application-exit
